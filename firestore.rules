rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isFollowing(ownerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(ownerId));
    }

    function canReadOwned(ownerId) {
      return isOwner(ownerId) || isFollowing(ownerId);
    }

    // Shared (Planner + Tracker)
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['displayName', 'email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.displayName is string;
      allow update: if isOwner(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /following/{targetUid} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // Tracker
    match /trackerIssues/{issueId} {
      allow read, write: if signedIn();
    }

    match /trackerProjects/{projectId} {
      allow read, write: if signedIn();
    }

    // Planner
    match /leaves/{leaveId} {
      allow read: if signedIn()
        && (canReadOwned(resource.data.ownerId)
            || request.auth.uid in resource.data.approverIds);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['draft', 'pending']
        && request.resource.data.currentStep == 0
        && request.resource.data.approvals.size() == 0;

      allow update: if signedIn() && (
        (
          resource.data.ownerId == request.auth.uid
          && resource.data.status in ['draft', 'rejected']
          && request.resource.data.ownerId == resource.data.ownerId
        )
        || (
          resource.data.ownerId == request.auth.uid
          && resource.data.status == 'draft'
          && request.resource.data.status == 'pending'
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.currentStep == 0
        )
        || (
          resource.data.status == 'pending'
          && resource.data.approverIds.size() > resource.data.currentStep
          && resource.data.approverIds[resource.data.currentStep] == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.approverIds == resource.data.approverIds
        )
      );

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status in ['draft', 'rejected'];
    }

    match /trips/{tripId} {
      allow read: if signedIn() && canReadOwned(resource.data.ownerId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /plans/{planId} {
      allow read: if signedIn() && canReadOwned(resource.data.ownerId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /meetings/{meetingId} {
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid
            || request.auth.uid in resource.data.participantIds);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /watchCategories/{categoryId} {
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.size() <= 30;
    }
  }
}
